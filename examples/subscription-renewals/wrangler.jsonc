{
  "name": "subscription-renewals-example",
  "main": "worker.ts",
  "compatibility_date": "2026-07-07",
  "durable_objects": {
    "bindings": [{ "name": "SUBSCRIPTIONS", "class_name": "Subscription" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Subscription"] }],
  "services": [{ "binding": "PAYMENTS", "service": "payments" }],
}
