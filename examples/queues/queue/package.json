{
  "name": "@queues-example/queue",
  "version": "0.0.0",
  "private": true,
  "description": "Partitioned FIFO queue with push and pull consumers, autoscaling, and an admin dashboard on Durable Objects",
  "type": "module",
  "scripts": {
    "build": "esbuild dashboard/main.ts --bundle --format=esm --target=es2022 --minify --outfile=public/app.js",
    "deploy": "npm run build && wrangler deploy",
    "dev": "npm run build && wrangler dev",
    "lint": "oxlint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@durability/transforms": "workspace:^",
    "durability": "workspace:^",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.17.0",
    "@cloudflare/workers-types": "^4.20260702.1",
    "esbuild": "^0.28.0",
    "typescript": "6.0.3",
    "vitest": "^4.1.5",
    "wrangler": "^4.156.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./consumer": "./src/consumer.ts"
  }
}
