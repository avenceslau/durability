{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fifo-queue",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-07",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/queues/*"],
  },
  // The Durable Objects are reached through the Worker's own exports, so they
  // need a migration but no binding.
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Partition",
        "Limiter",
        "Orchestrator",
        "Directory",
        "Redriver",
        "PullConsumer",
      ],
    },
  ],
  "kv_namespaces": [{ "binding": "TOPOLOGY" }],
  // Targets of type `rpc` and `service` name a service binding declared here.
  // `ORDERS` is the consumer in ../push_consumer, which must be deployed first.
  "services": [
    { "binding": "ORDERS", "service": "push-consumer", "entrypoint": "Orders" },
    // The dashboard's load test, from ../loadgen. Deploy that Worker, then
    // uncomment these and deploy this one again.
    // { "binding": "LOADGEN", "service": "queue-loadgen", "entrypoint": "LoadControl" },
    // { "binding": "LOAD_SINK", "service": "queue-loadgen", "entrypoint": "Sink" },
  ],
  "r2_buckets": [
    { "binding": "STORAGE", "bucket_name": "fifo-queue" },
    { "binding": "PULL", "bucket_name": "fifo-queue-pull" },
  ],
}
