{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "queue-loadgen",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-07",
  "observability": { "enabled": true },
  // Reached only through the queue's service bindings to `LoadControl` and `Sink`.
  "workers_dev": false,
  "preview_urls": false,
  // The controller wakes every generator from one alarm run.
  "limits": { "subrequests": 10000 },
  // The Durable Objects are reached through the Worker's own exports, so they
  // need a migration but no binding.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["LoadController", "LoadGenerator"] },
  ],
  "services": [
    {
      "binding": "QUEUE",
      "service": "fifo-queue",
      "entrypoint": "QueueBinding",
    },
    {
      "binding": "QUEUE_ADMIN",
      "service": "fifo-queue",
      "entrypoint": "QueueAdmin",
    },
  ],
}
