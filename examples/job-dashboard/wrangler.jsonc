{
  "name": "job-dashboard-example",
  "main": "worker.ts",
  "compatibility_date": "2026-07-07",
  "durable_objects": {
    "bindings": [
      { "name": "PIPELINE", "class_name": "Pipeline" },
      { "name": "DASHBOARD", "class_name": "Dashboard" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Pipeline", "Dashboard"] },
  ],
  "services": [{ "binding": "ORDERS", "service": "orders-api" }],
}
