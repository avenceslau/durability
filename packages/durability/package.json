{
  "name": "durability",
  "version": "5.2.2",
  "description": "Alarm-backed durable operations and typed WebSocket sync for Cloudflare Durable Objects",
  "type": "module",
  "license": "ISC",
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "bench:load": "vitest run --config vitest.bench.config.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "lint": "oxlint",
    "prepack": "pnpm build",
    "test": "vitest run && vitest run --config vitest.workers.config.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.client.json"
  },
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/socket/client.ts",
    "./experimental": "./src/experimental.ts",
    "./routing": "./src/routing/index.ts",
    "./socket": "./src/socket/index.ts",
    "./experimental/semaphore": "./src/semaphore/index.ts",
    "./utils": "./src/utils.ts"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./client": {
        "types": "./dist/socket/client.d.ts",
        "import": "./dist/socket/client.js"
      },
      "./experimental": {
        "types": "./dist/experimental.d.ts",
        "import": "./dist/experimental.js"
      },
      "./routing": {
        "types": "./dist/routing/index.d.ts",
        "import": "./dist/routing/index.js"
      },
      "./socket": {
        "types": "./dist/socket/index.d.ts",
        "import": "./dist/socket/index.js"
      },
      "./experimental/semaphore": {
        "types": "./dist/semaphore/index.d.ts",
        "import": "./dist/semaphore/index.js"
      },
      "./utils": {
        "types": "./dist/utils.d.ts",
        "import": "./dist/utils.js"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/avenceslau/durability.git",
    "directory": "packages/durability"
  },
  "homepage": "https://github.com/avenceslau/durability#readme",
  "bugs": {
    "url": "https://github.com/avenceslau/durability/issues"
  },
  "keywords": [
    "alarms",
    "cloudflare",
    "durable-objects",
    "idempotency",
    "retries",
    "workers"
  ],
  "dependencies": {
    "@durability/storage": "workspace:^",
    "@durability/transforms": "workspace:^",
    "@standard-schema/spec": "^1.1.0",
    "valibot": "^1.5.0"
  },
  "peerDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1"
  },
  "peerDependenciesMeta": {
    "@cloudflare/workers-types": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.17.0",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@durability/typescript-config": "workspace:*",
    "@types/node": "^24.12.0",
    "capnweb": "^0.12.0",
    "typescript": "6.0.3",
    "vite": "^8.0.0",
    "vitest": "^4.1.5"
  }
}
