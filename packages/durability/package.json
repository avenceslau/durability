{
  "name": "durability",
  "version": "2.0.0",
  "description": "Alarm-backed durable operations for Cloudflare Durable Objects",
  "type": "module",
  "license": "ISC",
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "lint": "oxlint",
    "prepack": "pnpm build",
    "test": "vitest run && vitest run --config vitest.workers.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    ".": "./src/index.ts",
    "./utils": "./src/utils.ts"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./utils": {
        "types": "./dist/utils.d.ts",
        "import": "./dist/utils.js"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/avenceslau/durability.git",
    "directory": "packages/durability"
  },
  "homepage": "https://github.com/avenceslau/durability#readme",
  "bugs": {
    "url": "https://github.com/avenceslau/durability/issues"
  },
  "keywords": [
    "alarms",
    "cloudflare",
    "durable-objects",
    "idempotency",
    "retries",
    "workers"
  ],
  "dependencies": {
    "@durability/storage": "workspace:^",
    "@standard-schema/spec": "^1.1.0",
    "workers-qb": "1.11.2",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1"
  },
  "peerDependenciesMeta": {
    "@cloudflare/workers-types": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.17.0",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@durability/typescript-config": "workspace:*",
    "@types/node": "^24.12.0",
    "typescript": "6.0.3",
    "vite": "^8.0.0",
    "vitest": "^4.1.5"
  }
}
