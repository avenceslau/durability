{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "durability-alarm-test",
  "main": "tests/named-alarm-worker.ts",
  "compatibility_date": "2026-07-07",
  "durable_objects": {
    "bindings": [
      {
        "name": "ALARM_TEST",
        "class_name": "NamedAlarmTestObject",
      },
      {
        "name": "SOCKET_TEST",
        "class_name": "SocketTestObject",
      },
      {
        "name": "TRACKER_TEST",
        "class_name": "TrackerTestObject",
      },
      {
        "name": "OUTBOX_TEST",
        "class_name": "OutboxObject",
      },
      {
        "name": "LIMIT_TEST",
        "class_name": "LimitObject",
      },
    ],
  },
  "services": [
    {
      "binding": "CONSUMER",
      "service": "durability-alarm-test",
      "entrypoint": "FanoutConsumer",
    },
  ],
  "r2_buckets": [
    {
      "binding": "DEAD_LETTERS",
      "bucket_name": "queue-test-dead-letters",
    },
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["NamedAlarmTestObject"],
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["DeliveryObject"],
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["SocketTestObject"],
    },
    {
      "tag": "v4",
      "new_sqlite_classes": ["LogTestObject"],
    },
    {
      "tag": "v5",
      "new_sqlite_classes": ["TrackerTestObject"],
    },
    {
      "tag": "v6",
      "new_sqlite_classes": ["OutboxObject"],
    },
    {
      "tag": "v7",
      "new_sqlite_classes": ["LimitObject"],
    },
  ],
}
