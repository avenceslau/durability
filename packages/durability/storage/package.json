{
  "name": "@durability/storage",
  "version": "0.1.0",
  "description": "Shared migration types for Cloudflare Durable Object storage",
  "type": "module",
  "license": "ISC",
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "lint": "oxlint",
    "prepack": "pnpm build",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "keywords": [
    "cloudflare",
    "durable-objects",
    "migrations",
    "sqlite",
    "workers"
  ],
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "typescript": "6.0.3"
  }
}
