{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": false,
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "sourceMap": false,
    "types": ["@cloudflare/workers-types", "node"]
  },
  "include": [
    "src/index.ts",
    "src/client.ts",
    "src/experimental.ts",
    "src/routing.ts",
    "src/socket.ts",
    "src/utils.ts"
  ],
  "exclude": ["dist", "node_modules", "src/**/*.test.ts"]
}
