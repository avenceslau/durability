{
  "name": "@durability/transforms",
  "version": "0.2.0",
  "description": "Typed caller and callee transforms for Cloudflare RPC",
  "type": "module",
  "license": "ISC",
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "lint": "oxlint",
    "prepack": "pnpm build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    ".": "./src/index.ts",
    "./vite": "./src/vite.ts"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./vite": {
        "types": "./dist/vite.d.ts",
        "import": "./dist/vite.js"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/avenceslau/durability.git",
    "directory": "packages/transforms"
  },
  "homepage": "https://github.com/avenceslau/durability/tree/main/packages/transforms#readme",
  "bugs": {
    "url": "https://github.com/avenceslau/durability/issues"
  },
  "keywords": [
    "cloudflare",
    "durable-objects",
    "middleware",
    "rpc",
    "workers"
  ],
  "dependencies": {
    "@babel/parser": "^7.28.5",
    "@standard-schema/spec": "^1.1.0",
    "jsonc-parser": "^3.3.1",
    "magic-string": "^0.30.21"
  },
  "peerDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "better-result": "^2.9.2",
    "vite": "^8.0.0",
    "wrangler": "4.107.0"
  },
  "peerDependenciesMeta": {
    "@cloudflare/workers-types": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "wrangler": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.17.0",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@durability/typescript-config": "workspace:*",
    "@types/node": "^24.12.0",
    "better-result": "^2.9.2",
    "typescript": "6.0.3",
    "vite": "^8.0.0",
    "vitest": "^4.1.5",
    "wrangler": "4.107.0"
  }
}
