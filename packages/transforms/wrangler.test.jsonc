{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "do-transforms-test",
  "main": "tests/worker.ts",
  "compatibility_date": "2026-07-07",
  "services": [
    {
      "binding": "CONTEXT_SERVICE",
      "service": "do-transforms-test",
      "entrypoint": "ContextService",
    },
    {
      "binding": "CROSS_WORKER_SERVICE",
      "service": "do-transforms-cross-worker",
      "entrypoint": "CrossWorkerContextService",
    },
    {
      "binding": "CACHE_READS",
      "service": "do-transforms-test",
      "entrypoint": "CacheDOReads",
    },
  ],
  "exports": {
    "CacheDOReads": { "type": "worker", "cache": { "enabled": true } },
  },
  "kv_namespaces": [{ "binding": "KV", "id": "transforms-test-kv" }],
  "r2_buckets": [
    { "binding": "BUCKET", "bucket_name": "transforms-test-bucket" },
  ],
  "workflows": [
    {
      "binding": "WORKFLOW",
      "name": "transforms-test-workflow",
      "class_name": "EchoWorkflow",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CONTEXT_DO",
        "class_name": "ContextDO",
      },
      {
        "name": "PIPELINE_DO",
        "class_name": "PipelineDO",
      },
      {
        "name": "CACHE_DO",
        "class_name": "CacheDO",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ContextDO", "PipelineDO"],
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["CacheDO"],
    },
  ],
}
