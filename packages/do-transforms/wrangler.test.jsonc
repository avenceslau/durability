{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "do-transforms-test",
  "main": "src/test-worker.ts",
  "compatibility_date": "2026-07-07",
  "services": [
    {
      "binding": "CONTEXT_SERVICE",
      "service": "do-transforms-test",
      "entrypoint": "ContextService"
    },
    {
      "binding": "CROSS_WORKER_SERVICE",
      "service": "do-transforms-cross-worker",
      "entrypoint": "CrossWorkerContextService"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CONTEXT_DO",
        "class_name": "ContextDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ContextDO"]
    }
  ]
}
