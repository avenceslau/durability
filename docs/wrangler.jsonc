{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "durability-docs",
  "compatibility_date": "2026-10-30",
  "main": "./src/worker.ts",
  "workers_dev": false,
  "routes": [
    { "pattern": "durability.shirei.dev", "custom_domain": true },
    // A pull request's preview is served at <preview name>.shirei.dev, which
    // the preview workflow names durability-<number>. Without a host enabled
    // for previews, a preview has no URL.
    {
      "pattern": "shirei.dev",
      "custom_domain": true,
      "previews_enabled": true,
    },
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page",
  },
  // `wrangler preview` requires this block. It stays empty: a preview gets
  // the site's assets and nothing else.
  "previews": {},
}
