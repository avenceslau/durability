{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "durability-docs",
  "compatibility_date": "2026-10-30",
  "main": "./src/worker.ts",
  "workers_dev": false,
  // The site is served from the custom domains only. A pull request's preview
  // is not: it gets a workers.dev address, which this turns on. It is a
  // setting of the Worker that the deploy does not apply, so it is also set
  // in the Cloudflare dashboard; this keeps the file saying what is live.
  "preview_urls": true,
  "routes": [
    { "pattern": "durability.shirei.dev", "custom_domain": true },
    { "pattern": "shirei.dev", "custom_domain": true },
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page",
  },
  // `wrangler preview` requires this block. It stays empty: a preview gets
  // the site's assets and nothing else.
  "previews": {},
}
