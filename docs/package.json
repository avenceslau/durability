{
  "name": "durability-docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "node scripts/sync-reference.mjs && astro dev",
    "build": "node scripts/sync-reference.mjs && astro build",
    "preview": "wrangler dev --infer-origin-from-routes=false",
    "deploy": "pnpm build && wrangler deploy",
    "deploy:check": "wrangler deploy --dry-run",
    "lint": "oxlint",
    "typecheck": "node scripts/sync-reference.mjs && astro check",
    "test": "node --import ./scripts/raw-imports.mjs --test scripts/*.test.mjs src/kit/architecture/*.test.ts",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.0",
    "@astrojs/react": "^7.1.2",
    "@cloudflare/nimbus-docs": "0.19.1",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@iconify-json/ph": "^1.2.0",
    "@resvg/resvg-js": "^2.6.2",
    "astro": "^7.4.4",
    "clsx": "^2.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "satori": "^0.26.0",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/language-server": "2.16.13",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.1.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "pagefind": "^1.5.2",
    "tailwindcss": "^4.1.4",
    "typescript": "6.0.3",
    "wrangler": "^4.156.0"
  }
}
